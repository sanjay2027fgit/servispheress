PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/servisphere?retryWrites=true&w=majority

# Email delivery via Gmail SMTP (IPv4-only, fixes Render IPv6 issues)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_sender@gmail.com
EMAIL_PASS=your_google_app_password
EMAIL_FROM=your_sender@gmail.com

JWT_SECRET=replace_with_a_long_random_secret

# Razorpay (required for Razorpay checkout / order creation)
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
