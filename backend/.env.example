PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/servisphere?retryWrites=true&w=majority

# Email delivery via Resend (cloud-based, works reliably on Render)
# Get free API key at https://resend.com (100 emails/day free tier)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@servisphere.app

JWT_SECRET=replace_with_a_long_random_secret

# Razorpay (required for Razorpay checkout / order creation)
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
